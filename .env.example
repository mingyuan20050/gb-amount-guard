# 复制为 .env 并填入你的 Key（.env 已被 .gitignore 忽略，不会被提交）
# LLM 接入为 OpenAI 兼容协议，默认对接阿里云 DashScope（通义千问）

LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
